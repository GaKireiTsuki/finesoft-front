{
    "name": "@finesoft/front",
    "version": "0.5.1",
    "description": "Full-stack framework: router, DI, actions, SSR, and server — all in one package",
    "license": "MIT",
    "files": [
        "dist",
        "docs",
        "README.md"
    ],
    "type": "module",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./browser": {
            "types": "./dist/browser.d.mts",
            "default": "./dist/browser.mjs"
        },
        "./web": {
            "types": "./dist/web.d.mts",
            "import": "./dist/web.mjs"
        },
        "./node": {
            "types": "./dist/node.d.mts",
            "import": "./dist/node.mjs"
        },
        "./http": {
            "types": "./dist/http.d.mts",
            "import": "./dist/http.mjs"
        },
        "./worker": {
            "types": "./dist/worker.d.mts",
            "import": "./dist/worker.mjs"
        },
        "./core": {
            "types": "./dist/core.d.mts",
            "import": "./dist/core.mjs"
        },
        "./renderers/react/browser": {
            "types": "./dist/renderers/react/browser.d.mts",
            "import": "./dist/renderers/react/browser.mjs"
        },
        "./renderers/react/server": {
            "types": "./dist/renderers/react/server.d.mts",
            "import": "./dist/renderers/react/server.mjs"
        },
        "./renderers/vue/browser": {
            "types": "./dist/renderers/vue/browser.d.mts",
            "import": "./dist/renderers/vue/browser.mjs"
        },
        "./renderers/vue/server": {
            "types": "./dist/renderers/vue/server.d.mts",
            "import": "./dist/renderers/vue/server.mjs"
        },
        "./renderers/svelte/browser": {
            "types": "./dist/renderers/svelte/browser.d.mts",
            "import": "./dist/renderers/svelte/browser.mjs"
        },
        "./renderers/svelte/server": {
            "types": "./dist/renderers/svelte/server.d.mts",
            "import": "./dist/renderers/svelte/server.mjs"
        }
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepack": "node ../../scripts/prepare-front-publish.mjs",
        "postpack": "node ../../scripts/restore-front-publish.mjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@finesoft/browser": "workspace:*",
        "@finesoft/core": "workspace:*",
        "@finesoft/server": "workspace:*",
        "@finesoft/ssr": "workspace:*",
        "@finesoft/web": "workspace:*",
        "@hono/node-server": "^2.1.0",
        "@types/node": "catalog:",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "dotenv": "^17.4.2",
        "hono": "^4.13.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "svelte": "^5.55.1",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.41"
    },
    "peerDependencies": {
        "@hono/node-server": "^1.0.0 || ^2.0.0",
        "hono": "^4.0.0",
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "@hono/node-server": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
