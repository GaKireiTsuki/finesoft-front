{
    "name": "@finesoft/front",
    "version": "0.5.4",
    "description": "Application runtime, routing, native UI and platform hosts through one public API",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GaKireiTsuki/finesoft-front.git",
        "directory": "packages/front"
    },
    "bin": {
        "finesoft-types": "./dist/typegen-cli.mjs"
    },
    "files": [
        "dist",
        "docs",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "imports": {
        "#finesoft/implementation": {
            "types": "./dist/load-node.d.mts",
            "node": "./dist/load-node.mjs",
            "default": "./dist/load-portable.mjs"
        }
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "node": "./dist/index-node.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "vp pack && node ../../scripts/prepare-svelte-entry.mjs",
        "dev": "vp pack --watch",
        "prepack": "node ../../scripts/prepare-front-publish.mjs",
        "postpack": "node ../../scripts/restore-front-publish.mjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@finesoft/browser": "workspace:*",
        "@finesoft/core": "workspace:*",
        "@finesoft/server": "workspace:*",
        "@finesoft/ssr": "workspace:*",
        "@finesoft/web": "workspace:*",
        "@hono/node-server": "^2.1.0",
        "@types/node": "catalog:",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "hono": "^4.13.5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "svelte": "^5.55.1",
        "typescript": "catalog:",
        "undici": "7.29.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.41"
    },
    "peerDependencies": {
        "@hono/node-server": "^1.0.0 || ^2.0.0",
        "hono": "^4.13.5",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "svelte": "^5.0.0",
        "typescript": ">=5.4.0",
        "vite": ">=5.0.0",
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        },
        "@hono/node-server": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "svelte": {
            "optional": true
        }
    }
}
