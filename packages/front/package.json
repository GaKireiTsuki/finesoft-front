{
    "name": "@finesoft/front",
    "version": "0.5.1",
    "description": "Portable application runtime with explicit Web, browser, SSR, HTTP and platform entries",
    "license": "MIT",
    "files": [
        "dist",
        "docs",
        "README.md"
    ],
    "type": "module",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./browser": {
            "types": "./dist/browser.d.mts",
            "default": "./dist/browser.mjs"
        },
        "./web": {
            "types": "./dist/web.d.mts",
            "import": "./dist/web.mjs"
        },
        "./react": {
            "types": "./dist/react.d.mts",
            "import": "./dist/react.mjs"
        },
        "./vue": {
            "types": "./dist/vue.d.mts",
            "import": "./dist/vue.mjs"
        },
        "./svelte": {
            "types": "./dist/svelte.d.mts",
            "svelte": "./dist/svelte.mjs",
            "import": "./dist/svelte.mjs"
        },
        "./node": {
            "types": "./dist/node.d.mts",
            "import": "./dist/node.mjs"
        },
        "./http": {
            "types": "./dist/http.d.mts",
            "import": "./dist/http.mjs"
        },
        "./worker": {
            "types": "./dist/worker.d.mts",
            "import": "./dist/worker.mjs"
        },
        "./ssr": {
            "types": "./dist/ssr.d.mts",
            "import": "./dist/ssr.mjs"
        },
        "./vite": {
            "types": "./dist/vite.d.mts",
            "import": "./dist/vite.mjs"
        }
    },
    "scripts": {
        "build": "vp pack && node ../../scripts/prepare-svelte-entry.mjs",
        "dev": "vp pack --watch",
        "prepack": "node ../../scripts/prepare-front-publish.mjs",
        "postpack": "node ../../scripts/restore-front-publish.mjs"
    },
    "dependencies": {},
    "devDependencies": {
        "@finesoft/browser": "workspace:*",
        "@finesoft/core": "workspace:*",
        "@finesoft/server": "workspace:*",
        "@finesoft/ssr": "workspace:*",
        "@finesoft/web": "workspace:*",
        "@hono/node-server": "^2.1.0",
        "@types/node": "catalog:",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "hono": "^4.13.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "svelte": "^5.55.1",
        "typescript": "catalog:",
        "undici": "7.29.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.41"
    },
    "peerDependencies": {
        "@hono/node-server": "^1.0.0 || ^2.0.0",
        "hono": "^4.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "svelte": "^5.0.0",
        "typescript": ">=5.4.0",
        "vite": ">=5.0.0",
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        },
        "@hono/node-server": {
            "optional": true
        },
        "vite": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "svelte": {
            "optional": true
        }
    }
}
