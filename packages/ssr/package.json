{
    "name": "@finesoft/ssr",
    "version": "0.1.0",
    "private": true,
    "description": "Server-side rendering: SSR render pipeline and data serialization",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./inject": {
            "import": {
                "types": "./dist/inject.d.mts",
                "default": "./dist/inject.mjs"
            },
            "require": {
                "types": "./dist/inject.d.cts",
                "default": "./dist/inject.cjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch"
    },
    "dependencies": {
        "@finesoft/core": "workspace:*",
        "@finesoft/web": "workspace:*",
        "parse5": "catalog:"
    }
}
