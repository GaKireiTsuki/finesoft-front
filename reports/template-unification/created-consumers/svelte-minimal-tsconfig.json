{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "rootDir": ".",
        "paths": {
            "@finesoft/front": [
                "./.finesoft/front.d.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "env.d.ts",
        "vite.config.ts"
    ]
}
