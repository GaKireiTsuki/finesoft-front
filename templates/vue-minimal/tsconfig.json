{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@finesoft/front": ["./.finesoft/front.d.ts"]
        }
    },
    "include": ["src/**/*", "env.d.ts", "vite.config.ts"]
}
