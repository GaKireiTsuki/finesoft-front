{
    "compilerOptions": {
        "strict": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"],
            "@finesoft/front": ["../../packages/front/src/index.ts"],
            "@finesoft/front/browser": ["../../packages/front/src/browser.ts"],
            "@finesoft/core": ["../../packages/core/src/index.ts"],
            "@finesoft/browser": ["../../packages/browser/src/index.ts"],
            "@finesoft/ssr": ["../../packages/ssr/src/index.ts"],
            "@finesoft/server": ["../../packages/server/src/index.ts"],
            "@finesoft/web": ["../../packages/web/src/index.ts"],
            "@finesoft/front/web": ["../../packages/front/src/web.ts"],
            "@finesoft/front/vite": ["../../packages/front/src/vite.ts"],
            "@finesoft/front/ssr": ["../../packages/front/src/ssr.ts"],
            "@finesoft/front/http": ["../../packages/front/src/http.ts"],
            "@finesoft/front/worker": ["../../packages/front/src/worker.ts"],
            "@finesoft/front/node": ["../../packages/front/src/node.ts"],
            "@finesoft/server/*": ["../../packages/server/src/*"],
            "@finesoft/front/react": ["../../packages/front/src/react.ts"],
            "@finesoft/front/vue": ["../../packages/front/src/vue.ts"],
            "@finesoft/front/svelte": ["../../packages/front/src/svelte.ts"]
        }
    },
    "include": ["src/**/*", "env.d.ts", "vite.config.ts"]
}
